---

---

<section class="bg-base-100">
  <div
    class="grid max-w-7xl px-4 py-8 mx-auto lg:gap-8 xl:gap-0 lg:py-16 lg:grid-cols-12"
  >
    <div class="mr-auto place-self-center lg:col-span-7">
      <h1
        class="max-w-2xl mb-4 text-4xl font-extrabold tracking-tight leading-none md:text-5xl xl:text-6xl text-base-content"
      >
        Hey, I'm Levi.
      </h1>
      <p
        class="max-w-2xl mb-6 lg:mb-8 md:text-lg lg:text-xl text-base-content/60"
      >
        I share my passion for videography and
        travel to give viewers an inside look at the world's most unique
        short-term stays. From remote treehouses and custom A-frames to
        container homes and floating boathouses
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href="https://www.youtube.com/@LeviKellyTours"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          <span class="icon-[tabler--player-play] size-5"></span>
          Watch my Videos
        </a>
        <a href="/contact" class="btn btn-outline btn-secondary">
          Contact me
        </a>
      </div>
    </div>

    <div
      class="hidden lg:mt-0 lg:col-span-5 lg:flex lg:items-center lg:justify-center"
    >
      <div class="relative">
        <div
          class="absolute inset-0 rounded-full bg-primary/20 blur-3xl scale-110"
        >
        </div>
        <img
          src="/images/levi-photo.jpg"
          alt="Levi Kelly"
          class="relative rounded-full size-96 object-cover ring-4 ring-primary/30"
        />
      </div>
    </div>
  </div>
</section>
