---
import Testimonials from "../components/Testimonials.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const numbers = [
  { value: "750K+", label: "Subscribers" },
  { value: "144M+", label: "Total Views" },
  { value: "400+", label: "Videos" },
  { value: "6 yrs", label: "Full-time Creator" },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="bg-base-100 px-4 py-12">
    <div class="max-w-7xl mx-auto">
      <!-- Image on mobile — full width, above text -->
      <div class="mb-8 lg:hidden">
        <img
          src="/images/levi-about-photo.webp"
          alt="Levi Kelly"
          class="w-full rounded-3xl object-cover ring-4 ring-primary/30 shadow-xl"
        />
      </div>

      <div class="flex items-center gap-16">
        <!-- Image on desktop — left side -->
        <div class="hidden lg:block w-96 shrink-0">
          <div class="relative">
            <div
              class="absolute inset-0 rounded-3xl bg-primary/20 blur-3xl scale-110"
            >
            </div>
            <img
              src="/images/levi-about-photo.webp"
              alt="Levi Kelly"
              class="relative w-full rounded-3xl object-cover ring-4 ring-primary/30 shadow-xl"
            />
          </div>
        </div>

        <!-- Text — right side on desktop, full width on mobile -->
        <div class="flex-1 min-w-0">
          <p
            class="text-primary text-xs font-semibold uppercase tracking-widest mb-4"
          >
            The story behind the channel
          </p>
          <h1 class="text-4xl font-extrabold text-base-content mb-4">
            Hey, there!
          </h1>
          <div class="w-12 h-1 rounded-full bg-secondary mb-6"></div>
          <p class="text-base-content/60 text-lg leading-relaxed mb-4">
            Over the past 6 years I have married my enthusiasm for videography
            and travel by creating a YouTube channel dedicated to showcasing
            unique, short-term stays. There you can find the best of tiny homes,
            treehouses, container homes, and luxury accommodations. You can also
            stream full episodes of my show, <em>Tiny BNB</em> on Hulu.
          </p>
          <p class="text-base-content/60 text-lg leading-relaxed mb-4">
            My goal is to benefit property owners who are looking to promote
            their homes, those who are planning a weekend away, or those looking
            for inspiration for their next unique home project. In 2019, I
            pursued YouTube full time and I am blessed to say that it has grown
            beyond what I could have imagined.
          </p>
          <p class="text-base-content/60 text-lg leading-relaxed mb-4">
            In 2021, my wife Savannah decided to leave her job as a High School
            Spanish teacher to work alongside me and stay home with our sons,
            Weston & Bishop. Together we strive to create high quality content
            we genuinely enjoy. In our spare time we like to hang out with
            family, play games, or enjoy a big bowl of cereal while watching The
            Chosen.
          </p>
          <p class="text-base-content/60 text-lg leading-relaxed">
            Thanks for stopping by!<br />
            <span
              class="text-secondary font-semibold italic"
              style="font-family: Georgia, serif;"
            >
              — Levi & Savannah
            </span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="px-4 mt-12 mb-4">
    <div class="max-w-7xl mx-auto flex flex-wrap gap-4">
      {
        numbers.map((number) => (
          <div
            class="bg-base-200 border border-base-300 rounded-2xl p-6 text-center"
            style="flex: 1 1 140px;"
          >
            <p class="text-3xl font-extrabold text-primary mb-1">
              {number.value}
            </p>
            <p class="text-base-content/60 text-xs font-semibold uppercase tracking-widest">
              {number.label}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Testimonials -->
  <section class="px-4 mt-8 mb-16">
    <div class="max-w-7xl mx-auto">
      <Testimonials />
    </div>
  </section>
</BaseLayout>
