---
import { getCollection } from "astro:content";
import { getLatestVideos } from "../lib/youtube";

import BlogCard from "../components/BlogCard.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import YoutubeCard from "../components/YoutubeCard.astro";

const blogs = await getCollection("blogs");
const videos = await getLatestVideos();

interface Video {
  title: string;
  thumbnail: string;
  link: string;
  published: string;
}
---

<BaseLayout>
  <Hero />

  <section class="mx-auto max-w-7xl mt-8">
    <h2 class="text-3xl font-bold text-center mb-16">My Latest Blog</h2>

    <div class="grid grid-cols-1 gap-8 my-8 mx-auto px-4 py-4">
      {blogs.map((blog) => <BlogCard blog={blog} />)}
    </div>

    <div class="flex justify-center my-8 py-4">
      <button class="btn btn-primary-soft">Explore more</button>
    </div>
  </section>

  <section class="mx-auto max-w-7xl mt-16">
    <h2 class="text-3xl font-bold text-center mb-16">
      Watch my Youtube Videos
    </h2>

    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 my-8 mx-auto px-4 py-4"
    >
      {videos.map((video: Video) => <YoutubeCard video={video} />)}
    </div>
  </section>
</BaseLayout>
